<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulut yedeğine ve cihaz aktarımına uygulama verisi (oturum anahtarı) dahil edilmez.
     Kullanıcının verileri zaten sunucuda; yeni cihazda giriş yapınca geri gelir. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
