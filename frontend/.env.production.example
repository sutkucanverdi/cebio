# Mobil uygulama ve web derlemesinin bağlanacağı API adresi (HTTPS zorunlu).
# Bu dosyayı .env.production olarak kopyalayıp düzenleyin, sonra:
#   npm run build && npx cap sync
VITE_API_BASE_URL=https://api.ornek-alan-adi.com

# Yasal sayfaların yayınlandığı web sitesi ve destek e-postası (Ayarlar ekranı ve mağaza formları)
VITE_PUBLIC_SITE_URL=https://ornek-alan-adi.com
VITE_SUPPORT_EMAIL=destek@ornek-alan-adi.com

# RevenueCat genel SDK anahtarları (gizli değildir). Boşsa uygulama içi satın alma gizlenir.
VITE_REVENUECAT_APPLE_KEY=
VITE_REVENUECAT_GOOGLE_KEY=
