# Cebio Backend Konfigürasyonu
APP_NAME="Cebio API"
APP_VERSION="0.2.0"
# Production'da False yapın (False iken JWT_SECRET zorunludur)
DEBUG=True

# Google Gemini Ayarları
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Veritabanı (göreli SQLite yolları backend/ klasörüne göre çözülür)
# Production örneği: postgresql+psycopg://user:pass@host:5432/cebio
DATABASE_URL=sqlite:///./cebio.db
# Açılışta Alembic migration'larını otomatik uygula
AUTO_MIGRATE=True

# Kimlik Doğrulama (JWT)
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# Fiş görseli yükleme limiti (MB)
MAX_UPLOAD_MB=10

# AI asistan istek limiti (kullanıcı başına, pencere saniye cinsinden)
ASSISTANT_RATE_LIMIT=30
ASSISTANT_RATE_WINDOW_SECONDS=600

# CORS İzin Verilen Origin'ler (virgülle ayrılmış veya *)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
