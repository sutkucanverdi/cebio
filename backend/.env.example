# Cebio Backend Konfigürasyonu
APP_NAME="Cebio API"
APP_VERSION="0.1.0"
DEBUG=True

# Google Gemini Ayarları
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Veritabanı Bağlantısı (SQLite)
DATABASE_URL=sqlite:///./cebio.db

# CORS İzin Verilen Origin'ler (virgülle ayrılmış veya *)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
